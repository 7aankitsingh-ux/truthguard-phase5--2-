# ==============================================================================
# TruthGuard AI Production Environment Variables Template
# Copy this file to .env.production and provide production credentials.
# NEVER commit .env.production containing real secrets to version control.
# ==============================================================================

# Node Environment ('production' enforces strict error hiding and cookie security)
NODE_ENV=production
PORT=4000

# Client Web Origin for CORS & Same-Origin mutating request verification
CLIENT_ORIGIN=https://truthguard.ai
HTTP_PORT=80

# PostgreSQL Production Database Connection
POSTGRES_USER=truthguard_admin
POSTGRES_PASSWORD=generate_a_minimum_32_char_random_password_here
POSTGRES_DB=truthguard_production
DATABASE_URL=postgresql://truthguard_admin:generate_a_minimum_32_char_random_password_here@db:5432/truthguard_production

# Session & Security Lifetimes
SESSION_TTL_HOURS=168

# File Upload Storage (Local directory or persistent container mount)
STORAGE_DIR=/app/uploads
MAX_FILE_SIZE_MB=50

# Request Timing & Size Guardrails
FETCH_TIMEOUT_MS=10000
MAX_WEBPAGE_BYTES=5242880

# External Fact-Checking & Search Integrations (Optional)
# If left empty, TruthGuard uses indexed knowledge bases and honest fallback reporting.
GOOGLE_FACTCHECK_API_KEY=
EXTERNAL_SEARCH_API_KEY=
REVERSE_IMAGE_API_KEY=
EXTERNAL_AI_DETECTOR_API_KEY=
